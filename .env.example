# Copy to .env and fill in. .env is gitignored — never commit real values.

# HubSpot Private App token.
# Client portal → Settings → Integrations → Private Apps → Create.
# Required scopes:
#   crm.schemas.custom.read     crm.schemas.contacts.read
#   crm.schemas.companies.read  crm.schemas.deals.read
#   crm.objects.custom.read     crm.objects.contacts.read
#   crm.objects.companies.read  crm.objects.deals.read
#   crm.objects.owners.read     tickets
# A token missing a scope produces a SILENTLY INCOMPLETE schema, not an error.
HUBSPOT_TOKEN=pat-na1-REPLACE-ME

# Numeric portal ID (HubSpot UI, top-right account menu).
HUBSPOT_PORTAL_ID=00000000

# Salesforce CLI org alias. Sandbox or Developer Edition — never prod here.
SF_ORG_ALIAS=client-sbx

# Client slug. Namespaces per-client state so one repo serves many migrations.
CLIENT_NAME=prototype

# Production safety interlock. guard_deploy.py refuses any deploy to an alias
# containing "prod" unless this is set to 1. Set it per-session, deliberately,
# on the command line — never write 1 into a committed file.
MIGRATION_ALLOW_PROD=0
